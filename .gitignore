# dbt build artifacts — fully regenerated by `dbt build`/`dbt compile`,
# committing them just creates noise and risks going stale vs the source.
target/
dbt_packages/
logs/
.user.yml

# local Python virtual environment — rebuilt from requirements.txt
.venv/
__pycache__/
*.pyc

# the local DuckDB database — regenerated by load_raw_data.py + dbt build,
# and a binary blob that doesn't belong in source control
tracksuit.duckdb
tracksuit.duckdb.wal
*.duckdb
*.duckdb.wal

# OS cruft
.DS_Store
